APP_NAME="NACS-Phil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Phase 48 security observability. Never put authentication secrets in logs.
NACS_SECURITY_LOG_CHANNEL=security
NACS_SECURITY_LOG_LEVEL=info
NACS_SECURITY_LOG_DAYS=90
NACS_SECURITY_LOG_HTTP_RESPONSES=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nacs_phil
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production target (do not force these on local HTTP development):
# APP_DEBUG=false
# APP_URL=https://your-real-domain
# SESSION_LIFETIME=60
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# Keep SESSION_HTTP_ONLY=true and SESSION_SAME_SITE=lax or strict.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Adaptive anti-bot protection is prepared but disabled for local development.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Phase 41 student/parent portal and external confidential document storage.
# Leave the school email domain blank until NACS owns/approves the real domain.
NACS_SCHOOL_EMAIL_DOMAIN=
NACS_STUDENT_DOCUMENT_STORAGE=external
NACS_STUDENT_DOCUMENT_PROVIDER=google_drive
NACS_GOOGLE_SHARED_DRIVE_ID=
# Phase 47 - private student media + future payment readiness
NACS_STUDENT_PHOTO_DISK=local
NACS_STUDENT_DOCUMENT_STORAGE=external
NACS_STUDENT_DOCUMENT_PROVIDER=google_drive
NACS_GOOGLE_SHARED_DRIVE_ID=
NACS_PAYMENTS_ENABLED=false
NACS_PAYMENT_PROVIDER=
NACS_PAYMENT_CURRENCY=PHP
NACS_PAYMENT_WEBHOOK_SECRET=
